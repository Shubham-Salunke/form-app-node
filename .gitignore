# Node modules (both frontend and backend)
node_modules/
frontend/node_modules/
backend/node_modules/

# Build output
dist/
build/
frontend/build/
frontend/dist/
backend/dist/

# Environment variables
.env
.env.*
frontend/.env
backend/.env

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS-generated files
.DS_Store
Thumbs.db

# IDEs and editors
.vscode/
.idea/

# Test coverage
coverage/

# Lock files (if using only one package manager, ignore the others)
# Uncomment one of the following if needed
# yarn.lock
# package-lock.json
# pnpm-lock.yaml

# Optional: runtime data
*.pid
*.seed

# Optional: cache folders
.next/
.vite/
.cache/

# Misc
*.local
*.sublime-project
*.sublime-workspace